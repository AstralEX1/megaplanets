# ─────────────────────────────────────────────────────────────────────────────
# MegaPlanets — local development environment
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Referrer attribution — the one value most forks should change
#
# You earn the protocol's referral fee on every ticket purchased and the
# referral win share on every winning claimed through your app. Both
# rates are protocol-level and readable at runtime via
# `Jackpot.getDrawingState().referralFee` / `.referralWinShare` (1e18).
#
# Default below is the public MegaPlanets referrer address. Override it only
# for an explicitly approved testing or deployment configuration.
# See https://llms.megapot.io/tasks/claim-referral-fees for the
# claim flow.
# ─────────────────────────────────────────────────────────────────────────────

# Wallet that earns referral fees. Must be a non-zero EVM address — the
# Jackpot contract reverts with `ZeroAddress()` on `0x0…0`.
VITE_REFERRER_ADDRESS=0xCfc1044C749fD40E07FE33938414Fa573993F857

# ─────────────────────────────────────────────────────────────────────────────
# Chain + RPC
#
# These two vars must agree. Switching VITE_CHAIN=testnet requires also
# flipping VITE_RPC_URL to a Sepolia endpoint; otherwise hooks will silently
# read mainnet state with testnet contract addresses (or vice versa).
# ─────────────────────────────────────────────────────────────────────────────

# Chain to use. Determines which contract addresses + RPC are wired up.
#   mainnet — Base mainnet (production), chain ID 8453
#   testnet — Base Sepolia (free test USDC), chain ID 84532
VITE_CHAIN=testnet

# RPC endpoint for the active chain.
#
# DEFAULT (public RPC): rate-limited, fine for casual local dev only.
# For reliable testing or production, swap to a free dedicated endpoint:
#   - Alchemy:  https://www.alchemy.com/base   (free tier covers most dev needs)
#   - Goldsky:  https://goldsky.com            (Edge endpoints, low-latency)
#   - QuickNode, Infura, Ankr, etc. — any HTTPS Base RPC works.
#
# Pick the line that matches VITE_CHAIN above:
# Public Base Sepolia RPC is sufficient for Stage 1. Use a dedicated
# provider before running sustained event indexing or a public deployment.
VITE_RPC_URL=https://sepolia.base.org
# Optional comma-separated RPC fallbacks for historical receipts and logs.
# VITE_RPC_FALLBACK_URLS=https://base-sepolia-rpc.publicnode.com,https://base-sepolia.gateway.tenderly.co

# ─────────────────────────────────────────────────────────────────────────────
# Wallet provider
# ─────────────────────────────────────────────────────────────────────────────

# WalletConnect project ID. Get a free one at https://cloud.walletconnect.com
# (~2 min signup). Optional but recommended.
#
#   Set:    full RainbowKit modal — WalletConnect QR, Rainbow, MetaMask
#           mobile, plus injected wallets and Coinbase Wallet.
#   Empty:  degraded mode — only browser-extension wallets (MetaMask,
#           Rabby, Brave, Phantom, etc.) and Coinbase Wallet (its own SDK).
#           The WC QR modal, Rainbow, and MetaMask mobile deep links are
#           disabled. The kit logs a dev-mode warning so you know why.
#
# Free tier MAU quota is ~10K monthly active users; busy production forks
# that hit the cap will see modal connection errors. Upgrade in the
# WalletConnect Cloud dashboard or self-host if you exceed it.
VITE_WALLETCONNECT_PROJECT_ID=

# App name shown in wallet-connect modals (RainbowKit / WalletConnect).
# Set this on rebrand. Falls back to "Megapot Starter Kit" if empty.
VITE_APP_NAME=MegaPlanets

# Active Base Sepolia MegaPlanets ERC721A V2. Leave empty until deployment is
# explicitly approved and the address, block, signer, owner, and bytecode are
# verified together. Historical V1 deployments are not supported.
VITE_MEGAPLANETS_CONTRACT_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Megapot Data API — three tiers of key handling. Pick one.
#
#   1. Anonymous (default)
#      Leave VITE_MEGAPOT_API_KEY empty, leave VITE_API_BASE_URL empty.
#      Browser hits api.megapot.io directly, rate-limited (10/min, 500/day).
#      Works on any static host (Vercel static, Cloudflare Pages, GitHub
#      Pages, S3 + CloudFront, etc.).
#
#   2. Browser key — simplest higher-tier path
#      Set VITE_MEGAPOT_API_KEY. Higher tier (60/min, 10K/day).
#      The key ships to the browser bundle (Vite injects VITE_* at build).
#      That's acceptable for the read-only Data API — rate-limited per
#      key, revocable from the dashboard. Rotate if it leaks.
#      Still static-host friendly.
#
#   3. Proxy — key never reaches the browser
#      Set MEGAPOT_API_KEY (no VITE_ prefix, server-side env only) AND
#      VITE_API_BASE_URL=/api/megapot. Requires a backend to deploy
#      server/proxy.ts on — see examples/ for Vercel Functions and
#      Cloudflare Workers wrappers. Use this when you have a privileged
#      key or your fork is multi-tenant.
#
# Get a key from https://megapot.io/dashboard (sign in first). Copy once
# and store like a password — Megapot does not retain a retrievable copy.
# Full reference: https://llms.megapot.io/data-api § "Get a Key".
# ─────────────────────────────────────────────────────────────────────────────

# Browser-injected Data API key (tier 2). Empty = anonymous (tier 1).
VITE_MEGAPOT_API_KEY=

# Override the Data API base URL. Set to /api/megapot for the proxy tier
# (tier 3). Empty = default https://api.megapot.io/v1.
VITE_API_BASE_URL=

# Shared public base URL for the Planet index, mining, leaderboard, and voucher
# APIs in a split frontend/API deployment. Leave empty for same-origin local
# development. The legacy VITE_PLANET_API_BASE_URL below remains a compatibility
# fallback for voucher-only deployments.
VITE_BACKEND_API_BASE_URL=

# Legacy voucher-only base URL; prefer VITE_BACKEND_API_BASE_URL.
VITE_PLANET_API_BASE_URL=

# Standalone Node API listener. The API remains separate from the Vite frontend.
# MEGAPLANETS_API_HOST=127.0.0.1
# MEGAPLANETS_API_PORT=8787

# Server-only Base Sepolia/API/indexer configuration. Keep these values in the
# host secret manager or gitignored .env.local; never expose them through VITE_*.
# BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc.example
# Optional comma-separated archive-capable fallbacks for historical receipts.
# BASE_SEPOLIA_RPC_FALLBACK_URLS=https://sepolia.base.org
# MEGAPLANETS_CONTRACT_ADDRESS=0x7a29bfD9d1A7a243A212d4E81bc9A52bE50fb9f2
# MEGAPLANETS_PLANET_DEPLOYMENT_BLOCK=45347860
# MEGAPLANETS_LAUNCH_BLOCK=44997183
# MEGAPLANETS_METADATA_SIGNER_PRIVATE_KEY=0x...
# PINATA_JWT=...

# Persistent local path for the Stage 5 voucher/indexer store. This is server-only;
# use a transactional managed database rather than a local file for a multi-instance deployment.
# MEGAPLANETS_STORE_PATH=.data/megaplanets-stage5.json
# MEGAPLANETS_PLANET_DEPLOYMENT_BLOCK=

# Optional MVP PostgreSQL index. Without DATABASE_URL the existing local voucher
# store remains active. Never expose either value through a VITE_ variable.
# DATABASE_URL=postgresql://user:password@host-pooler:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Public origin bound into wallet sign-in messages and secure session policy.
# MEGAPLANETS_APP_ORIGIN=http://127.0.0.1:5173
# MEGAPLANETS_SESSION_TTL_SECONDS=86400

# Server-side Data API key (tier 3 only). Read by server/proxy.ts; never
# exposed to the browser. Do NOT prefix with VITE_.
# MEGAPOT_API_KEY=
