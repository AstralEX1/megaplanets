{
  "name": "megaplanets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MegaPlanets MVP: deterministic collectible planets powered by Megapot tickets on Base.",
  "scripts": {
    "bootstrap": "pnpm install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@megaplanets/planet-generator": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "hono": "^4.12.21",
    "ogl": "1.0.11",
    "pg": "^8.22.0",
    "postprocessing": "6.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.180.0",
    "tslib": "^2.8.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
